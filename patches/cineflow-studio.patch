@@ -0,0 +1,49 @@
+(() => {
+  const token = new URLSearchParams(location.hash.slice(1)).get('bridge');
+  const listeners = new Map();
+  const headers = { authorization: 'Bearer ' + token };
+  window.cineflowStudioBridge = {
+    contextBridge: { exposeInMainWorld(name, value) { window[name] = value; } },
+    ipcRenderer: {
+      async invoke(channel, ...args) {
+        if (channel.startsWith('window:')) return { mode: 'normal' };
+        // 应用内更新器在工作室里停用：检查更新返回「由工作室管理」而不是失败，界面据此显示说明
+        if (channel === 'update:check') return { ok: true, managed: true, message: '升级请用工作室的「版本与更新」' };
+        if (channel.startsWith('update:')) return { ok: false, error: '请通过 dsh 工作库升级影音插件' };
+        const response = await fetch('/studio/rpc', { method: 'POST', headers: { ...headers, 'content-type': 'application/json' }, body: JSON.stringify({ channel, args }) });
+        const body = await response.json();
+        if (!response.ok) throw new Error(body.error || '影音工作室连接失败');
+        return body.result;
+      },
+      send() { /* 嵌入视图的窗口拖动由 dsh 负责。 */ },
+      on(channel, callback) {
+        if (!listeners.has(channel)) listeners.set(channel, new Set());
+        listeners.get(channel).add(callback);
+      },
+      removeListener(channel, callback) { listeners.get(channel)?.delete(callback); }
+    }
+  };
+  const controller = new AbortController();
+  addEventListener('pagehide', () => controller.abort(), { once: true });
+  async function events() {
+    const response = await fetch('/studio/events', { headers, signal: controller.signal });
+    if (!response.ok) throw new Error('影音事件连接失败');
+    const reader = response.body.getReader();
+    const decoder = new TextDecoder(); let buffer = '';
+    while (true) {
+      const { value, done } = await reader.read(); if (done) break;
+      buffer += decoder.decode(value, { stream: true });
+      let end;
+      while ((end = buffer.indexOf('\n\n')) >= 0) {
+        const chunk = buffer.slice(0, end); buffer = buffer.slice(end + 2);
+        if (!chunk.startsWith('data: ')) continue;
+        const event = JSON.parse(chunk.slice(6));
+        for (const callback of listeners.get(event.channel) || []) callback({}, event.payload);
+      }
+    }
+  }
+  void events().catch(error => { if (!controller.signal.aborted) console.error('影音工作室状态连接中断，请重新打开。'); });
+  addEventListener('DOMContentLoaded', () => {
+    document.querySelectorAll('.window-controls, #islandRestoreBtn, #islandDockHandle').forEach(node => node.remove());
+  }, { once: true });
+})();
diff --git a/electron/studio-resource-payload.cjs b/electron/studio-resource-payload.cjs
new file mode 100644
index 0000000..7c1e8d6
--- /dev/null
+++ b/electron/studio-resource-payload.cjs
@@ -0,0 +1,26 @@
+const { XMLParser } = require('fast-xml-parser');
+const parser = new XMLParser({ ignoreAttributes: false, parseTagValue: false, processEntities: false });
+const array = value => value == null ? [] : Array.isArray(value) ? value : [value];
+const text = value => typeof value === 'object' && value ? String(value['#text'] || '') : String(value || '');
+
+/** 苹果 CMS 的 XML 与 JSON 返回统一的影片及播放线路字段。 */
+exports.parseResourcePayload = function parseResourcePayload(source) {
+  const input = String(source || '').replace(/^\uFEFF/, '').trim();
+  if (!input.startsWith('<')) return JSON.parse(input);
+  if (/<!DOCTYPE|<!ENTITY/i.test(input)) throw new Error('资源 XML 声明不受支持');
+  const payload = parser.parse(input);
+  const list = payload.rss?.list;
+  if (!list) throw new Error('资源 XML 缺少影片列表');
+  return {
+    page: Number(list['@_page'] || 1), pagecount: Number(list['@_pagecount'] || 1), total: Number(list['@_recordcount'] || 0),
+    list: array(list.video).map(video => {
+      const lines = array(video.dl?.dd);
+      return {
+        vod_id: text(video.id), vod_name: text(video.name), vod_pic: text(video.pic), vod_year: text(video.year),
+        type_name: text(video.type), vod_remarks: text(video.note), vod_content: text(video.des),
+        vod_play_from: lines.map(line => line['@_flag'] || '默认线路').join('$$$'),
+        vod_play_url: lines.map(text).join('$$$')
+      };
+    })
+  };
+};
diff --git a/electron/studio-sources.cjs b/electron/studio-sources.cjs
new file mode 100644
index 0000000..41a1a74
--- /dev/null
+++ b/electron/studio-sources.cjs
@@ -0,0 +1,110 @@
+const catalog = require('../studio-source-catalog.json');
+const { parseResourcePayload } = require('./studio-resource-payload.cjs');
+
+function canonicalApi(raw) {
+  try {
+    const url = new URL(raw);
+    url.searchParams.delete('ac');
+    url.pathname = url.pathname.replace(/\/+$/, '');
+    return url.href.replace(/\?$/, '');
+  } catch { return ''; }
+}
+
+/** 协议与 CMS 输出格式不改变片库身份，线路和认证参数仍需独立保留。 */
+function resourceIdentity(raw) {
+  try {
+    const url = new URL(canonicalApi(raw));
+    if (!['http:', 'https:'].includes(url.protocol)) return '';
+    url.pathname = url.pathname.replace(/(\/provide\/vod)\/at\/(?:xml|xm|json)(?=\/|$)/i, '$1');
+    url.searchParams.sort();
+    return `${url.username}:${url.password}@${url.host}${url.pathname}${url.search}`;
+  } catch { return ''; }
+}
+
+function deduplicateResourceSources(entries) {
+  const seen = new Set();
+  return entries.filter(source => {
+    const key = resourceIdentity(source?.api || source?.url);
+    if (!key || seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+}
+
+/** 提供商相同的镜像只合并展示，不丢弃实际播放线路。 */
+function resourceProvider(source) {
+  const name = String(source.name || '').trim().replace(/資/g, '资').replace(/閃/g, '闪').replace(/電/g, '电').replace(/紅/g, '红');
+  return { key: name || resourceIdentity(source.api), name: name || '未命名源' };
+}
+
+/** 仅接收当前播放器能够直接读取的 CMS JSON/XML，不执行外部爬虫。 */
+function tvBoxSiteToSourceEntry(site) {
+  const type = site?.type === undefined ? '' : String(site.type).trim();
+  const api = String(site?.api || '').trim();
+  if (!['', '0', '1'].includes(type) || !/^https?:\/\//i.test(api) || /\.(?:js|jar)(?:[?#]|$)/i.test(api)) return null;
+  return { name: site.name || site.key || '', api: canonicalApi(api), note: type === '0' ? 'TVBox XML 采集接口' : 'TVBox JSON 采集接口' };
+}
+
+function resourceVerification(api) {
+  return catalog.sources.find(source => canonicalApi(source.api) === canonicalApi(api))?.verification || null;
+}
+
+function resourceProbe(api) {
+  return catalog.probes.find(source => canonicalApi(source.url) === canonicalApi(api)) || null;
+}
+
+/** 升级时补齐旧版遗漏的种子；迁移完成后尊重用户的删除和清空操作。 */
+function migrateStudioResourceSources(settings, normalize, seeds = require('../studio-sources.json').sources) {
+  const version = Number(settings.studioSourceSeedVersion || 0);
+  if (version >= 3) return false;
+  const current = Array.isArray(settings.customResourceSources) ? [...settings.customResourceSources] : [];
+  const seen = new Set(current.map(source => resourceIdentity(source?.api || source?.url)));
+  for (const [index, seed] of (version < 2 ? seeds : []).entries()) {
+    const source = normalize({ ...seed, key: seed.id }, index, 'custom');
+    const api = resourceIdentity(source?.api);
+    if (!api || seen.has(api)) continue;
+    seen.add(api);
+    current.push(source);
+  }
+  settings.customResourceSources = deduplicateResourceSources(current);
+  settings.studioSourceSeedVersion = 3;
+  return true;
+}
+
+function validateResourcePayload(text) {
+  let payload;
+  try { payload = parseResourcePayload(text); }
+  catch { throw new Error('未返回有效采集数据，可能是网页、验证页或接口格式不兼容'); }
+  if (!payload || !Array.isArray(payload.list)) throw new Error('响应缺少影片列表，不能作为采集接口');
+  return payload;
+}
+
+/** 网页检测只说明页面能否访问，不宣称影片能够直连播放。 */
+async function testWebsite(fetch, raw) {
+  const site = catalog.websites.find(item => item.url === String(raw || ''));
+  if (!site) return { ok: false, state: 'unknown', error: '自定义网站请通过原站检查，内置站点支持在线检测' };
+  const started = Date.now();
+  const checkedAt = new Date().toISOString();
+  try {
+    const response = await fetch(site.url, { signal: AbortSignal.timeout(8000), cache: 'no-store' });
+    const reader = response.body.getReader();
+    const chunks = [];
+    let size = 0;
+    try {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        chunks.push(Buffer.from(value)); size += value.length;
+        if (size > 2 * 1024 * 1024) break;
+      }
