+    setStatus(`正在测活 ${list.length} 个频道…`);
+    try {
+      const results = await liveApi.probe(list.map((channel) => channel.url));
+      const now = Date.now();
+      for (const result of results || []) store.probe[result.url] = { ok: result.ok, ms: result.ms, error: result.error || '', at: now };
