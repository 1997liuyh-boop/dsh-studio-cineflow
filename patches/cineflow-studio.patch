+  const url = String(value ?? '').trim();
+  return /^https?:\/\//i.test(url) ? url : '';
+}
+
+/** 把采集站返回的 vod_* 列表映射为统一的搜索结果条目。 */
+export function parseCmsList(payload, source = {}) {
+  const list = Array.isArray(payload?.list) ? payload.list : [];
+  return list
+    .filter((item) => item && (item.vod_id !== undefined && item.vod_id !== null) && item.vod_name)
+    .map((item) => ({
+      sourceKey: String(source.key || ''),
+      sourceName: String(source.name || ''),
+      vodId: String(item.vod_id),
+      name: cleanText(item.vod_name, 120),
+      pic: cleanImage(item.vod_pic),
+      typeName: cleanText(item.type_name, 40),
+      year: String(item.vod_year || '').match(/\d{4}/)?.[0] || '',
+      area: cleanText(item.vod_area, 40),
+      remarks: cleanText(item.vod_remarks || item.vod_pubdate, 60),
+      updatedAt: cleanText(item.vod_time, 30)
+    }));
+}
+
+/** 读取第一页的总页数，缺失或非法时视为 1 页。 */
+export function readPageCount(payload) {
+  const value = Number.parseInt(String(payload?.pagecount ?? '1'), 10);
+  return Number.isFinite(value) && value > 0 ? value : 1;
+}
+
+/** 单源结果过滤：相关性 + 成人内容 + 源内去重。 */
+export function filterSearchItems(items, query, { filterAdult = true } = {}) {
+  const prepared = prepareQuery(query);
+  const seen = new Set();
+  return items.filter((item) => {
+    const key = `${item.sourceKey}_${item.vodId}`;
+    if (seen.has(key)) return false;
+    seen.add(key);
+    if (filterAdult && isAdult(item)) return false;
+    return isRelevant(item.name, prepared);
+  });
+}
+
+function mostCommon(values) {
+  const counts = new Map();
+  for (const value of values) if (value) counts.set(value, (counts.get(value) || 0) + 1);
+  let best = '';
+  let bestCount = 0;
+  for (const [value, count] of counts) {
+    if (count > bestCount) {
+      best = value;
+      bestCount = count;
+    }
+  }
+  return best;
+}
+
+function buildGroup(key, items, query) {
+  const sources = new Set(items.map((item) => item.sourceKey));
+  const name = mostCommon(items.map((item) => item.name)) || items[0]?.name || '';
+  const normalized = normalizeTitle(name);
+  const first = (field) => items.find((item) => item[field])?.[field] || '';
+  return {
+    key,
+    name,
+    year: mostCommon(items.map((item) => item.year)),
+    typeName: mostCommon(items.map((item) => item.typeName)),
+    area: first('area'),
+    pic: first('pic'),
+    remarks: mostCommon(items.map((item) => item.remarks)),
+    sourceCount: sources.size,
+    exact: Boolean(query.normalized) && normalized === query.normalized,
+    prefix: Boolean(query.normalized) && normalized.startsWith(query.normalized),
+    noise: items.every(isNoise),
+    items
+  };
+}
+
+/**
+ * 跨源聚合：同名（归一化后）合并为一组；同名但年份不同的拆成多组，
+ * 没有年份的条目在只有一个年份时并入该组，否则单独成组。
+ * 排序：精确命中 → 正片优先于解说 → 以查询开头 → 来源多 → 片名。
+ */
+export function aggregateResults(items, query) {
+  const prepared = typeof query === 'object' && query && 'normalized' in query ? query : prepareQuery(query);
+  const buckets = new Map();
+  for (const item of items) {
+    const key = normalizeTitle(item.name);
+    if (!key) continue;
+    if (!buckets.has(key)) buckets.set(key, []);
+    buckets.get(key).push(item);
+  }
+  const groups = [];
+  for (const [key, bucket] of buckets) {
+    const years = [...new Set(bucket.map((item) => item.year).filter(Boolean))];
+    if (years.length <= 1) {
+      groups.push(buildGroup(`${key}|${years[0] || ''}`, bucket, prepared));
+      continue;
+    }
+    for (const year of years) {
+      groups.push(buildGroup(`${key}|${year}`, bucket.filter((item) => item.year === year), prepared));
+    }
+    const yearless = bucket.filter((item) => !item.year);
+    if (yearless.length) groups.push(buildGroup(`${key}|`, yearless, prepared));
+  }
+  return groups.sort((a, b) =>
+    Number(b.exact) - Number(a.exact)
+    || Number(a.noise) - Number(b.noise)
+    || Number(b.prefix) - Number(a.prefix)
+    || b.sourceCount - a.sourceCount
+    || a.name.localeCompare(b.name, 'zh-Hans-CN')
+    || String(b.year).localeCompare(String(a.year))
+  );
+}
+
+const MAX_PLAY_GROUPS = 16;
+const MAX_EPISODES = 3000;
+
+/**
+ * 拆分播放地址：线路用 $$$ 分隔，剧集用 # 分隔，每集「名称$地址」。
+ * 只保留 http(s) 地址；直链 m3u8 线路排在网页播放线路之前；保留剧集名。
+ */
+export function splitPlayGroups(item = {}) {
+  const fromGroups = String(item.vod_play_from || '').split('$$$');
+  const urlGroups = String(item.vod_play_url || '').split('$$$');
+  const groups = [];
+  urlGroups.forEach((group, groupIndex) => {
+    const episodes = [];
+    String(group || '').split('#').forEach((segment) => {
+      const clean = segment.trim();
+      if (!clean) return;
+      const dollar = clean.lastIndexOf('$');
+      const label = dollar > 0 ? clean.slice(0, dollar).trim() : '';
+      const url = (dollar >= 0 ? clean.slice(dollar + 1) : clean).trim();
+      if (!/^https?:\/\//i.test(url)) return;
+      if (episodes.length >= MAX_EPISODES) return;
+      episodes.push({ label: label || `第${episodes.length + 1}集`, url });
+    });
+    if (!episodes.length) return;
+    const name = String(fromGroups[groupIndex] || fromGroups[0] || '').trim() || `线路 ${groupIndex + 1}`;
+    const m3u8 = episodes.filter((episode) => /\.m3u8(?:$|[?#])/i.test(episode.url)).length;
+    groups.push({ name, episodes, directRatio: m3u8 / episodes.length, order: groupIndex });
+  });
+  return groups
+    .sort((a, b) => (b.directRatio >= 0.5) - (a.directRatio >= 0.5) || a.order - b.order)
+    .slice(0, MAX_PLAY_GROUPS)
+    .map(({ name, episodes }) => ({ name, episodes }));
+}
+
+/** 详情条目的元数据（简介去掉 HTML 标签）。 */
+export function parseDetailMeta(item = {}, source = {}) {
+  return {
+    sourceKey: String(source.key || ''),
+    sourceName: String(source.name || ''),
+    vodId: String(item.vod_id ?? ''),
+    name: cleanText(item.vod_name, 120),
+    pic: cleanImage(item.vod_pic),
+    typeName: cleanText(item.type_name, 40),
+    year: String(item.vod_year || '').match(/\d{4}/)?.[0] || '',
+    area: cleanText(item.vod_area, 60),
+    lang: cleanText(item.vod_lang, 40),
+    remarks: cleanText(item.vod_remarks, 60),
+    director: cleanText(item.vod_director, 120),
+    actor: cleanText(item.vod_actor, 300),
+    content: cleanText(item.vod_content || item.vod_blurb, 1200)
+  };
+}
diff --git a/electron/vod-health.cjs b/electron/vod-health.cjs
new file mode 100644
index 0000000..2042721
--- /dev/null
+++ b/electron/vod-health.cjs
@@ -0,0 +1,105 @@
+// 片源健康度：根据每次搜索的成败自动停用连续失败的采集站，按阶梯延长停用时长。
+// 规则设计参考 LibreTV-Next，代码为独立实现。
+
+const FAIL_THRESHOLD = 2; // 连续失败多少次触发停用
+const DISABLE_LADDER_MS = [30 * 60 * 1000, 24 * 60 * 60 * 1000]; // 第 1、2 级停用时长，第 3 级起长期停用
+const RECORD_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 超过 7 天未更新的记录清理掉
+
+/** 清理过期记录，返回新对象。 */
+function pruneHealth(health = {}, now = Date.now()) {
+  const next = {};
+  for (const [key, entry] of Object.entries(health || {})) {
+    if (!entry || typeof entry !== 'object') continue;
+    // 长期停用的记录不过期，否则重启后会被悄悄恢复
+    if (!entry.permanent && now - Number(entry.at || 0) > RECORD_TTL_MS) continue;
+    next[key] = entry;
+  }
+  return next;
+}
+
+/** 当前是否处于停用状态（到期后惰性恢复，不需要定时器）。 */
+function isDisabled(entry, now = Date.now()) {
+  if (!entry) return false;
+  return Boolean(entry.permanent) || Number(entry.disabledUntil || 0) > now;
+}
+
+/**
+ * 记录一次搜索结果，返回 { health, events }。
+ * outcome: { key, ok, ms, error, timedOut }
+ * - 成功：清空连续失败与停用状态，停用等级下降一级；
+ * - 失败：连续失败 +1（停用到期后的第一次失败从 1 重新计数），
+ *   达到阈值且当前未停用时，按等级停用 30 分钟 → 24 小时 → 长期。
+ */
+function recordOutcomes(health = {}, outcomes = [], now = Date.now()) {
+  const next = pruneHealth(health, now);
+  const events = [];
+  for (const outcome of outcomes) {
+    const key = String(outcome?.key || '');
+    if (!key) continue;
+    const previous = next[key] || {};
+    if (outcome.ok) {
+      next[key] = {
+        ok: true,
+        ms: Number(outcome.ms) || 0,
+        failStreak: 0,
+        disableLevel: Math.max(0, Number(previous.disableLevel || 0) - 1),
+        at: now
+      };
+      continue;
+    }
+    const expired = Number(previous.disabledUntil || 0) > 0 && Number(previous.disabledUntil) <= now && !previous.permanent;
+    const failStreak = expired ? 1 : Number(previous.failStreak || 0) + 1;
+    const entry = {
+      ok: false,
+      ms: Number(outcome.ms) || 0,
+      error: String(outcome.error || '请求失败').slice(0, 120),
+      timedOut: Boolean(outcome.timedOut),
+      failStreak,
+      disableLevel: Number(previous.disableLevel || 0),
+      at: now
+    };
+    if (!expired && isDisabled(previous, now)) {
+      // 仍在停用期内（例如手动指定搜索），保持原停用状态
+      entry.disabledUntil = previous.disabledUntil;
+      entry.permanent = previous.permanent;
+    } else if (failStreak >= FAIL_THRESHOLD) {
+      const level = entry.disableLevel + 1;
+      const ttl = DISABLE_LADDER_MS[level - 1];
+      entry.disableLevel = level;
+      if (ttl) entry.disabledUntil = now + ttl;
+      else entry.permanent = true;
+      events.push({ key, level, permanent: !ttl, ttlMs: ttl || 0 });
+    }
+    next[key] = entry;
+  }
+  return { health: next, events };
+}
+
+/** 手动恢复：删除该源的健康记录；不传 key 时全部清空。 */
+function resetHealth(health = {}, key) {
+  if (!key) return {};
+  const next = { ...health };
+  delete next[key];
+  return next;
+}
+
+/** 给界面展示用的状态摘要。 */
+function describeHealth(entry, now = Date.now()) {
+  if (!entry) return { status: 'unknown', label: '未检测' };
+  if (entry.permanent) return { status: 'disabled', label: '已长期停用', permanent: true, error: entry.error || '' };
+  if (Number(entry.disabledUntil || 0) > now) {
+    return { status: 'disabled', label: '暂时停用', disabledUntil: entry.disabledUntil, error: entry.error || '' };
+  }
+  if (entry.ok) return { status: 'ok', label: '正常', ms: entry.ms || 0 };
+  return { status: 'failing', label: `失败 ${entry.failStreak || 1} 次`, error: entry.error || '' };
+}
+
+module.exports = {
+  FAIL_THRESHOLD,
+  DISABLE_LADDER_MS,
+  pruneHealth,
+  isDisabled,
+  recordOutcomes,
+  resetHealth,
+  describeHealth
+};
diff --git a/electron/vod-service.cjs b/electron/vod-service.cjs
new file mode 100644
index 0000000..0a9a57e
--- /dev/null
+++ b/electron/vod-service.cjs
@@ -0,0 +1,166 @@
+// 采集站聚合搜索服务：多页并行搜索、整源死线、详情获取、健康度记录与持久化。
+// 依赖由 main.cjs 注入，便于复用现有的请求缓存、代理与设置读写。
+
+const health = require('./vod-health.cjs');
+
+const PAGE_TIMEOUT_MS = Number(process.env.CINEFLOW_VOD_PAGE_TIMEOUT_MS || 8000); // 单页超时
+const SOURCE_DEADLINE_MS = Number(process.env.CINEFLOW_VOD_SOURCE_DEADLINE_MS || 10000); // 整源死线
+const MAX_PAGES = Math.min(20, Math.max(1, Number(process.env.CINEFLOW_VOD_MAX_PAGES || 5))); // 每源最多翻页数
+const DETAIL_TIMEOUT_MS = 10000;
+const HEALTH_PERSIST_DELAY_MS = 1500;
+
+function createVodService({ ipcMain, fetchJson, listSources, readSettings, writeSettings, playbackMeta }) {
+  let corePromise = null;
+  // vod-core 是 ESM（渲染层同样使用），主进程按需动态加载一次
+  const loadCore = () => (corePromise ||= import('./vod-core.mjs'));
+
+  let healthState = null;
+  let persistTimer = null;
+
+  function currentHealth() {
+    if (!healthState) healthState = health.pruneHealth(readSettings().sourceHealth || {});
+    return healthState;
+  }
+
+  function persistHealthSoon() {
+    clearTimeout(persistTimer);
+    persistTimer = setTimeout(() => {
+      try {
+        const settings = readSettings();
+        settings.sourceHealth = healthState || {};
+        writeSettings(settings);
+      } catch {
+        // 健康度只是辅助信息，写盘失败不影响搜索
+      }
+    }, HEALTH_PERSIST_DELAY_MS);
+  }
+
+  function recordOutcomes(outcomes) {
+    const result = health.recordOutcomes(currentHealth(), outcomes);
+    healthState = result.health;
+    persistHealthSoon();
+    return result.events;
+  }
+
+  function publicSource(source, now = Date.now()) {
+    const entry = currentHealth()[source.key];
+    return {
+      key: source.key,
+      name: source.name,
+      api: source.api,
+      origin: source.origin || 'builtin',
+      disabled: health.isDisabled(entry, now),
+      health: health.describeHealth(entry, now)
+    };
+  }
+
+  /** 全部已启用的采集站（含被健康度停用的，由调用方决定是否跳过）。 */
+  function enabledSources() {
+    return listSources().filter((source) => source && source.api && source.enabled !== false);
+  }
+
+  /** 搜索单个采集站：先取第 1 页读 pagecount，再并行取后续页；整源受死线约束，单页失败只丢该页。 */
+  async function searchSource(source, wd, core) {
+    const startedAt = Date.now();
+    const controller = new AbortController();
+    const deadline = setTimeout(() => controller.abort(), SOURCE_DEADLINE_MS);
+    const fetchPage = (page) => fetchJson(source, { ac: 'videolist', wd, pg: page }, { timeoutMs: PAGE_TIMEOUT_MS, signal: controller.signal });
+    try {
+      const first = await fetchPage(1);
+      const items = core.parseCmsList(first, source);
+      const pageCount = Math.min(core.readPageCount(first), MAX_PAGES);
+      if (pageCount > 1) {
+        const pages = await Promise.all(
+          Array.from({ length: pageCount - 1 }, (_, index) => fetchPage(index + 2)
+            .then((payload) => core.parseCmsList(payload, source))
+            .catch(() => []))
+        );
+        items.push(...pages.flat());
+      }
+      return {
+        key: source.key,
+        name: source.name,
+        ok: true,
+        ms: Date.now() - startedAt,
+        pages: pageCount,
+        list: core.filterSearchItems(items, wd)
+      };
+    } catch (error) {
+      const timedOut = controller.signal.aborted || error?.name === 'AbortError';
+      return {
+        key: source.key,
+        name: source.name,
+        ok: false,
+        ms: Date.now() - startedAt,
+        list: [],
+        timedOut,
+        error: timedOut ? `请求超时（>${Math.round(SOURCE_DEADLINE_MS / 1000)} 秒）` : String(error?.message || '请求失败').slice(0, 120)
+      };
+    } finally {
+      clearTimeout(deadline);
+    }
+  }
+
+  /** 搜索一批采集站；sourceKeys 为空时搜索全部未停用的源。 */
+  async function search(wd, sourceKeys) {
+    const query = String(wd ?? '').normalize('NFKC').trim();
+    if (!query || query.length > 100) return { ok: false, error: '搜索关键词无效', outcomes: [] };
+    const core = await loadCore();
+    const now = Date.now();
+    const healthMap = currentHealth();
+    const wanted = Array.isArray(sourceKeys) && sourceKeys.length ? new Set(sourceKeys.map(String)) : null;
+    const sources = enabledSources().filter((source) => (wanted ? wanted.has(source.key) : !health.isDisabled(healthMap[source.key], now)));
+    const outcomes = await Promise.all(sources.map((source) => searchSource(source, query, core)));
+    const events = recordOutcomes(outcomes.map(({ key, ok, ms, error, timedOut }) => ({ key, ok, ms, error, timedOut })));
+    return { ok: true, query, outcomes, disabledEvents: events };
+  }
+
+  /** 获取详情：依次尝试 ac=detail 与 ac=videolist；返回元数据与完整线路/剧集，耗时可作换源测速。 */
+  async function detail(sourceKey, vodId) {
+    const id = String(vodId ?? '').trim();
+    if (!/^[\w-]{1,64}$/.test(id)) return { ok: false, error: '无效的影片编号' };
+    const source = enabledSources().find((item) => item.key === String(sourceKey));
+    if (!source) return { ok: false, error: '片源不存在或已删除' };
+    const core = await loadCore();
+    const startedAt = Date.now();
+    let lastError = null;
+    for (const ac of ['detail', 'videolist']) {
+      try {
+        const payload = await fetchJson(source, { ac, ids: id }, { timeoutMs: DETAIL_TIMEOUT_MS });
+        const list = Array.isArray(payload?.list) ? payload.list : [];
+        const item = list.find((entry) => String(entry?.vod_id) === id) || list[0];
+        if (!item) continue;
+        const lines = core.splitPlayGroups(item).map((group) => ({
+          name: group.name,
+          episodes: group.episodes.map((episode) => ({ ...episode, ...playbackMeta(episode.url, group.name) }))
+        }));
+        if (!lines.length) continue;
+        return { ok: true, ms: Date.now() - startedAt, meta: core.parseDetailMeta(item, source), lines };
+      } catch (error) {
+        lastError = error;
+      }
+    }
+    return { ok: false, ms: Date.now() - startedAt, error: lastError ? String(lastError.message || lastError).slice(0, 120) : '该片源没有可播放的剧集' };
+  }
+
+  function listPublicSources() {
+    const now = Date.now();
+    return enabledSources().map((source) => publicSource(source, now));
+  }
+
+  function resetSourceHealth(key) {
+    healthState = health.resetHealth(currentHealth(), key ? String(key) : '');
+    persistHealthSoon();
+    return listPublicSources();
+  }
+
+  ipcMain.handle('vod:sources', async () => listPublicSources());
+  ipcMain.handle('vod:search', async (_event, wd, sourceKeys) => search(wd, sourceKeys));
+  ipcMain.handle('vod:detail', async (_event, sourceKey, vodId) => detail(sourceKey, vodId));
+  ipcMain.handle('health:list', async () => listPublicSources());
+  ipcMain.handle('health:reset', async (_event, key) => resetSourceHealth(key));
+
+  return { search, detail, listPublicSources, resetSourceHealth, recordOutcomes };
+}
+
+module.exports = { createVodService, MAX_PAGES, SOURCE_DEADLINE_MS };
diff --git a/electron/vod-subscriptions.cjs b/electron/vod-subscriptions.cjs
new file mode 100644
index 0000000..dc6ab97
--- /dev/null
+++ b/electron/vod-subscriptions.cjs
@@ -0,0 +1,388 @@
+// 片源订阅：解析远程源列表（LibreTV-SourceList JSON / TVBox 配置），定期静默刷新，导出当前片源。
+// 订阅格式参考 LibreTV-Next 的公开约定，代码为独立实现。订阅导入的接口单独存放，不覆盖用户的自定义源。
+
+const MAX_VOD_SOURCES = 200;
+const MAX_LIVE_SOURCES = 100;
+const AUTO_SYNC_LIMIT = 5; // 每次启动最多自动刷新的订阅数
+const AUTO_SYNC_CONCURRENCY = 2;
+const AUTO_PAUSE_FAILS = 3; // 自动刷新连续失败几次后暂停
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** 去掉 BOM、注释与尾逗号，容忍手写 JSON 的常见问题（字符串内的内容保持不变）。 */
+function stripJsonNoise(text) {
+  const source = String(text ?? '').replace(/^\uFEFF/, '');
+  let out = '';
+  let inString = false;
+  let quote = '';
+  for (let index = 0; index < source.length; index += 1) {
+    const char = source[index];
+    const next = source[index + 1];
+    if (inString) {
+      if (char === '\\') {
+        out += char + (next ?? '');
+        index += 1;
+        continue;
+      }
+      if (char === quote) inString = false;
+      // 字符串里的原始换行、制表符会让 JSON.parse 失败，转成转义序列
+      if (char === '\n') out += '\\n';
+      else if (char === '\r') out += '\\r';
+      else if (char === '\t') out += '\\t';
+      else out += char;
+      continue;
+    }
+    if (char === '"') {
+      inString = true;
+      quote = char;
+      out += char;
+      continue;
+    }
+    if (char === '/' && next === '/') {
+      while (index < source.length && source[index] !== '\n') index += 1;
+      out += '\n';
+      continue;
+    }
+    if (char === '/' && next === '*') {
+      index += 2;
+      while (index < source.length && !(source[index] === '*' && source[index + 1] === '/')) index += 1;
+      index += 1;
+      continue;
+    }
+    out += char;
+  }
+  // 尾逗号：「, }」「, ]」
+  return out.replace(/,(\s*[}\]])/g, '$1');
+}
+
+function hostName(url) {
+  try {
+    return new URL(url).hostname.replace(/^www\./i, '');
+  } catch {
+    return '';
+  }
+}
+
+function cleanUrl(value, { keepTrailingSlash = false } = {}) {
+  let url = String(value ?? '').trim();
+  if (!/^https?:\/\//i.test(url)) return '';
+  url = url.replace(/[?#]+$/, '');
+  if (!keepTrailingSlash) url = url.replace(/\/+$/, '');
+  try {
+    const normalized = new URL(url).toString();
+    return keepTrailingSlash ? normalized : normalized.replace(/\/$/, '');
+  } catch {
+    return '';
+  }
+}
+
+function addSkip(stats, reason, sample) {
+  stats.skipped += 1;
+  stats.skippedByReason[reason] = (stats.skippedByReason[reason] || 0) + 1;
+  if (sample && stats.skippedSamples.length < 5) stats.skippedSamples.push(sample);
+}
+
+/** TVBox 站点 → 可直接使用的 MacCMS 接口；爬虫类（type 3、jar/js/py、csp_）与不可搜索的站点跳过。 */
+function tvBoxSite(site, stats) {
+  const type = site?.type === undefined || site?.type === null ? '' : String(site.type).trim();
+  const api = String(site?.api || '').trim();
+  const name = String(site?.name || site?.key || '').trim();
+  if (type === '3' || /^csp_/i.test(api) || /\.(?:jar|js|py)(?:[?#]|$)/i.test(api) || /^\.\//.test(api)) {
+    addSkip(stats, '需要专用爬虫引擎', name);
+    return null;
+  }
+  if (String(site?.searchable ?? '1') === '0') {
+    addSkip(stats, '不支持搜索', name);
+    return null;
+  }
+  const url = cleanUrl(api);
+  const isCms = /\/provide\/vod/i.test(url) || type === '1';
+  if (!url || !['', '0', '1', '4'].includes(type) || !isCms) {
+    addSkip(stats, '接口格式不兼容', name);
+    return null;
+  }
+  return { name: name || hostName(url), url };
+}
+
+function tvBoxLive(live, stats) {
+  const type = live?.type === undefined || live?.type === null ? '0' : String(live.type).trim();
+  const url = cleanUrl(live?.url || live?.api, { keepTrailingSlash: true });
+  if (!url || type !== '0') {
+    addSkip(stats, '直播格式不兼容', live?.name || '');
+    return null;
+  }
+  if (/\.txt(?:[?#]|$)/i.test(url)) {
+    addSkip(stats, 'TXT 直播列表暂不支持', live?.name || '');
+    return null;
+  }
+  return { name: String(live?.name || hostName(url)), url, epg: cleanUrl(live?.epg, { keepTrailingSlash: true }) };
+}
+
+function dedupe(list, keyOf, limit, stats) {
+  const seen = new Set();
+  const out = [];
+  for (const item of list) {
+    if (!item) continue;
+    const key = keyOf(item);
+    if (!key || seen.has(key)) continue;
+    seen.add(key);
+    if (out.length >= limit) {
+      stats.truncated = true;
+      continue;
+    }
+    out.push(item);
+  }
+  return out;
+}
+
+/**
+ * 解析订阅内容，返回 { name, sources:[{name,url}], liveSources:[{name,url,epg}], stats }。
+ * 支持：LibreTV-SourceList（{ name, sources, liveSources } 或直接是点播源数组）与 TVBox 配置（sites / lives）。
+ */
+function parseSubscription(text) {
+  let json;
+  try {
+    json = JSON.parse(stripJsonNoise(text));
+  } catch {
+    throw new Error('订阅内容不是有效的 JSON（支持 LibreTV 源列表与 TVBox 配置）');
+  }
+  const stats = { format: '', accepted: 0, skipped: 0, skippedByReason: {}, skippedSamples: [], truncated: false };
+  let name = '';
+  let sources = [];
+  let liveSources = [];
+  if (Array.isArray(json)) {
+    stats.format = 'libretv';
+    sources = json;
+  } else if (json && typeof json === 'object' && (Array.isArray(json.sites) || Array.isArray(json.lives))) {
+    stats.format = 'tvbox';
+    sources = (json.sites || []).map((site) => tvBoxSite(site, stats));
+    liveSources = (json.lives || []).flatMap((live) => (Array.isArray(live?.channels) ? [] : [tvBoxLive(live, stats)]));
+  } else if (json && typeof json === 'object' && (Array.isArray(json.sources) || Array.isArray(json.liveSources))) {
+    stats.format = 'libretv';
+    name = String(json.name || '').trim();
+    sources = json.sources || [];
+    liveSources = json.liveSources || [];
+  } else {
+    throw new Error('无法识别的订阅格式：需要 sources / liveSources 或 TVBox 的 sites / lives');
+  }
+  if (stats.format === 'libretv') {
+    sources = sources.map((entry) => {
+      const url = cleanUrl(entry?.url || entry?.api);
+      if (!url) {
+        addSkip(stats, '地址无效', entry?.name || '');
+        return null;
+      }
+      return { name: String(entry?.name || hostName(url)).slice(0, 80), url };
+    });
+    liveSources = liveSources.map((entry) => {
+      const url = cleanUrl(entry?.url, { keepTrailingSlash: true });
+      if (!url) {
+        addSkip(stats, '直播地址无效', entry?.name || '');
+        return null;
+      }
+      return { name: String(entry?.name || hostName(url)).slice(0, 80), url, epg: cleanUrl(entry?.epg, { keepTrailingSlash: true }) };
+    });
+  }
+  sources = dedupe(sources, (item) => item.url.replace(/^https?:/i, ''), MAX_VOD_SOURCES, stats);
+  liveSources = dedupe(liveSources, (item) => item.url, MAX_LIVE_SOURCES, stats);
+  stats.accepted = sources.length + liveSources.length;
+  if (!stats.accepted) {
+    const reason = Object.keys(stats.skippedByReason).join('、');
+    throw new Error(`订阅里没有可直接使用的接口${reason ? `（已跳过：${reason}）` : ''}`);
+  }
+  return { name, sources, liveSources, stats };
+}
+
+/** 是否到了自动刷新时间。refreshDays 为 0 表示只手动刷新。 */
+function isDue(subscription, now = Date.now()) {
+  if (!subscription || subscription.enabled === false) return false;
+  const days = Number(subscription.refreshDays ?? 1);
+  if (!(days > 0)) return false;
+  if (Number(subscription.failStreak || 0) >= AUTO_PAUSE_FAILS) return false;
+  const last = Number(subscription.lastSync || 0);
+  return !last || now - last >= days * DAY_MS;
+}
+
+function normalizeSubscriptionUrl(value) {
+  const url = cleanUrl(value, { keepTrailingSlash: true });
+  if (!url) throw new Error('请输入 http(s) 开头的订阅地址');
+  return url;
+}
+
+/** 导出为 LibreTV-SourceList JSON。 */
+function buildExport({ sources = [], liveSources = [] } = {}) {
+  return {
+    name: 'CineFlow 片源',
+    exportedAt: new Date().toISOString(),
+    sources: sources.map((source) => ({ name: source.name, url: source.api || source.url })),
+    liveSources: liveSources.map((source) => ({ name: source.name, url: source.url, ...(source.epg ? { epg: source.epg } : {}) }))
+  };
+}
+
+/**
+ * 订阅服务。依赖：
+ * - fetchText(url)：拉取订阅内容（带代理与超时）
+ * - readSettings / writeSettings
+ * - onSourcesChanged(settings)：订阅源变化后通知主进程刷新配置版本与缓存
+ * - listExportSources()：当前全部启用的点播源
+ */
+function createSubscriptionService({ ipcMain, fetchText, readSettings, writeSettings, touchConfig, onSourcesChanged, listExportSources }) {
+  const inflight = new Map();
+
+  function listSubscriptions(settings = readSettings()) {
+    const subscriptions = Array.isArray(settings.subscriptions) ? settings.subscriptions : [];
+    const vod = Array.isArray(settings.subscriptionSources) ? settings.subscriptionSources : [];
+    const live = Array.isArray(settings.subscriptionLiveSources) ? settings.subscriptionLiveSources : [];
+    return subscriptions.map((subscription) => ({
+      ...subscription,
+      paused: Number(subscription.failStreak || 0) >= AUTO_PAUSE_FAILS,
+      sourceCount: vod.filter((source) => source.subscription === subscription.url).length,
+      liveCount: live.filter((source) => source.subscription === subscription.url).length
+    }));
+  }
+
+  function save(mutator) {
+    const settings = readSettings();
+    mutator(settings);
+    // 片源配置版本号变化后，渲染层与资源缓存会重新读取
+    touchConfig?.(settings);
+    writeSettings(settings);
+    onSourcesChanged?.(settings);
+    return settings;
+  }
+
+  async function sync(url, { manual = false } = {}) {
+    if (inflight.has(url)) return inflight.get(url);
+    const task = (async () => {
+      const existing = listSubscriptions().find((item) => item.url === url);
+      if (!existing) throw new Error('订阅不存在');
+      try {
+        const parsed = parseSubscription(await fetchText(url));
+        save((settings) => {
+          settings.subscriptionSources = [
+            ...(settings.subscriptionSources || []).filter((source) => source.subscription !== url),
+            ...parsed.sources.map((source, index) => ({ name: source.name, api: source.url, subscription: url, index }))
+          ];
+          settings.subscriptionLiveSources = [
+            ...(settings.subscriptionLiveSources || []).filter((source) => source.subscription !== url),
+            ...parsed.liveSources.map((source) => ({ ...source, subscription: url }))
+          ];
+          settings.subscriptions = (settings.subscriptions || []).map((item) => (item.url === url ? {
+            ...item,
+            name: item.name || parsed.name || hostName(url),
+            lastSync: Date.now(),
+            lastStatus: 'ok',
+            lastError: '',
+            failStreak: 0,
+            lastCounts: { sources: parsed.sources.length, live: parsed.liveSources.length, skipped: parsed.stats.skipped, format: parsed.stats.format, skippedByReason: parsed.stats.skippedByReason }
+          } : item));
+        });
+        return { ok: true, stats: parsed.stats, sources: parsed.sources.length, live: parsed.liveSources.length };
+      } catch (error) {
+        const message = String(error?.message || error).slice(0, 160);
+        // 服务端临时不可用（401 / 503）不计入连续失败
+        const transient = /\b(401|503)\b/.test(message);
+        save((settings) => {
+          settings.subscriptions = (settings.subscriptions || []).map((item) => (item.url === url ? {
+            ...item,
+            lastSync: manual ? item.lastSync : Date.now(),
+            lastStatus: 'error',
+            lastError: message,
+            failStreak: transient ? Number(item.failStreak || 0) : Number(item.failStreak || 0) + 1
+          } : item));
+        });
+        return { ok: false, error: message };
+      }
+    })().finally(() => inflight.delete(url));
+    inflight.set(url, task);
+    return task;
+  }
+
+  async function add(rawUrl, options = {}) {
+    const url = normalizeSubscriptionUrl(rawUrl);
+    save((settings) => {
+      const list = Array.isArray(settings.subscriptions) ? settings.subscriptions : [];
+      if (!list.some((item) => item.url === url)) {
+        list.push({
+          url,
+          name: String(options.name || '').trim().slice(0, 60),
+          refreshDays: Math.min(365, Math.max(0, Number(options.refreshDays ?? 1) || 0)),
+          enabled: true,
+          failStreak: 0,
+          addedAt: Date.now()
+        });
+      }
+      settings.subscriptions = list;
+    });
+    const result = await sync(url, { manual: true });
+    return { ...result, subscriptions: listSubscriptions() };
+  }
+
+  function remove(url) {
+    save((settings) => {
+      settings.subscriptions = (settings.subscriptions || []).filter((item) => item.url !== url);
+      settings.subscriptionSources = (settings.subscriptionSources || []).filter((source) => source.subscription !== url);
+      settings.subscriptionLiveSources = (settings.subscriptionLiveSources || []).filter((source) => source.subscription !== url);
+    });
+    return listSubscriptions();
+  }
+
+  function update(url, patch = {}) {
+    save((settings) => {
+      settings.subscriptions = (settings.subscriptions || []).map((item) => {
+        if (item.url !== url) return item;
+        const next = { ...item };
+        if (patch.name !== undefined) next.name = String(patch.name || '').trim().slice(0, 60);
+        if (patch.refreshDays !== undefined) next.refreshDays = Math.min(365, Math.max(0, Number(patch.refreshDays) || 0));
+        if (patch.enabled !== undefined) next.enabled = Boolean(patch.enabled);
+        return next;
+      });
+    });
+    return listSubscriptions();
+  }
+
+  /** 启动后静默刷新到期的订阅（最多 5 个，并发 2）。 */
+  async function autoSync() {
+    const due = listSubscriptions().filter((item) => isDue(item)).slice(0, AUTO_SYNC_LIMIT);
+    let cursor = 0;
+    const worker = async () => {
+      while (cursor < due.length) {
+        const item = due[cursor++];
+        await sync(item.url).catch(() => {});
+      }
+    };
+    await Promise.all(Array.from({ length: Math.min(AUTO_SYNC_CONCURRENCY, due.length) }, worker));
+    return due.length;
+  }
+
+  function exportSources() {
+    const settings = readSettings();
+    const live = [
+      ...(Array.isArray(settings.liveSources) ? settings.liveSources : []),
+      ...(Array.isArray(settings.subscriptionLiveSources) ? settings.subscriptionLiveSources : [])
+    ];
+    return JSON.stringify(buildExport({ sources: listExportSources(), liveSources: live }), null, 2);
+  }
+
+  ipcMain.handle('subscriptions:list', async () => listSubscriptions());
+  ipcMain.handle('subscriptions:add', async (_event, url, options) => add(url, options || {}));
+  ipcMain.handle('subscriptions:remove', async (_event, url) => remove(String(url || '')));
+  ipcMain.handle('subscriptions:update', async (_event, url, patch) => update(String(url || ''), patch || {}));
+  ipcMain.handle('subscriptions:sync', async (_event, url) => {
+    if (url) return { ...(await sync(String(url), { manual: true })), subscriptions: listSubscriptions() };
+    const results = [];
+    for (const item of listSubscriptions()) results.push(await sync(item.url, { manual: true }));
+    return { ok: results.every((result) => result.ok), results, subscriptions: listSubscriptions() };
+  });
+  ipcMain.handle('sources:export', async () => exportSources());
+
+  return { listSubscriptions, add, remove, update, sync, autoSync, exportSources };
+}
+
+module.exports = {
+  stripJsonNoise,
+  parseSubscription,
+  isDue,
+  buildExport,
+  createSubscriptionService,
+  AUTO_PAUSE_FAILS
+};
