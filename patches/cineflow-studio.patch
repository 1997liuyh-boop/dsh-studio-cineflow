+/** 片名归一化：统一全半角、转小写，去掉空白、标点与符号，用于比较与分组。 */
+export function normalizeTitle(value) {
+  return String(value ?? '')
+    .normalize('NFKC')
+    .toLowerCase()
+    .replace(/[\s\p{P}\p{S}]+/gu, '');
+}
