+body {
+  @apply overflow-clip;
+}
+
+#app {
+  @apply m-0 h-dvh w-full overflow-clip rounded-none border-0 shadow-none;
+}
+
+/* 嵌入后移除了原生窗口按钮，为工作室连接菜单保留一个入口的位置。 */
+.titlebar {
+  @apply h-auto shrink-0 grid-cols-[minmax(9rem,12rem)_minmax(0,1fr)_auto] gap-[0.75rem] pr-[4rem];
+}
+
+.app-shell {
+  @apply min-h-0 flex-1;
+}
+
+/* 页面入口始终可见，和键盘切页共用同一状态。 */
+.cf3-navigation {
+  @apply col-span-full flex flex-wrap items-center gap-[0.5rem] [app-region:no-drag];
+}
+
+.cf3-heading-row {
+  @apply flex items-center justify-between gap-[1rem];
