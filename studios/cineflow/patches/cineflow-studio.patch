diff --git a/src/studio-embedded.css b/src/studio-embedded.css
new file mode 100644
index 0000000..4b27449
--- /dev/null
+++ b/src/studio-embedded.css
@@ -0,0 +1,172 @@
+@reference "tailwindcss";
+
+.studio-source-help {
+  @apply my-[0.5rem] text-[0.75rem] leading-[1.6] [color:var(--muted)];
+}
+.studio-source-group {
+  @apply rounded-[0.875rem] border border-[#ffffff12] bg-[#ffffff08];
+}
+.studio-source-group > summary {
+  @apply cursor-pointer px-[0.75rem] py-[0.875rem] text-[0.8125rem] [color:var(--text)] hover:bg-[#ffffff08];
+}
+.studio-source-group > summary span {
+  @apply ml-[0.5rem] text-[0.6875rem] [color:var(--muted)];
+}
+.studio-source-lines {
+  @apply flex flex-col gap-[0.375rem] px-[0.5rem] pb-[0.5rem];
+}
+.cf5-status {
+  @apply shrink-0 empty:hidden;
+}
+.cf5-item .cf5-tags {
+  @apply flex-wrap;
+}
+
+/* 外层只负责裁切；滚动交给片单、抽屉和设置列表，避免隐藏抽屉带走整个页面。 */
+html,
+body {
+  @apply overflow-clip;
+}
+
+#app {
+  @apply m-0 h-dvh w-full overflow-clip rounded-none border-0 shadow-none;
+}
+
+/* 嵌入后移除了原生窗口按钮，为工作室连接菜单保留一个入口的位置。 */
+.titlebar {
+  @apply h-auto shrink-0 grid-cols-[minmax(9rem,12rem)_minmax(0,1fr)_auto] gap-[0.75rem] pr-[4rem];
+}
+
+.app-shell {
+  @apply min-h-0 flex-1;
+}
+
+/* 页面入口始终可见，和键盘切页共用同一状态。 */
+.cf3-navigation {
+  @apply col-span-full flex flex-wrap items-center gap-[0.5rem] [app-region:no-drag];
+}
+
+.cf3-heading-row {
+  @apply flex items-center justify-between gap-[1rem];
+}
+
+.cf3-filter-help,
+.cf3-filter-summary {
+  @apply my-[0.75rem] text-[0.8125rem] leading-[1.6] [color:var(--muted)];
+}
+
+.cf3-criteria {
+  @apply mb-[1rem] flex min-w-0 flex-col gap-[0.75rem];
+}
+
+.cf3-criteria .cf3-filter {
+  @apply m-0 min-w-0 items-center;
+}
+
+.cf3-option-row {
+  @apply flex min-w-0 flex-1 flex-nowrap gap-[0.5rem] overflow-x-auto overflow-y-hidden py-[0.375rem] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden;
+}
+
+.cf3-option-row .cf3-chip {
+  @apply shrink-0 whitespace-nowrap;
+}
+
+.cf3-field {
+  @apply flex min-w-0 flex-col gap-[0.5rem] text-[0.8125rem] [color:var(--muted)];
+}
+
+.cf3-field select,
+.cf3-field input {
+  @apply min-h-[2.625rem] w-full min-w-0 rounded-[0.75rem] border border-[#ffffff24] bg-[#11131d] px-[0.75rem] py-[0.5rem] text-[0.875rem] [color:var(--text)] [color-scheme:dark] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#a99cff];
+}
+
+.cf3-date-range {
+  @apply mb-[1rem] flex flex-wrap items-end gap-[0.75rem] rounded-[1rem] border border-[#ffffff14] bg-[#ffffff05] p-[1rem];
+}
+
+.cf3-date-range[hidden],
+.cf3-date-error[hidden] {
+  @apply hidden;
+}
+
+.cf3-date-range .cf3-field {
+  @apply min-w-[10rem] flex-1;
+}
+
+.cf3-date-separator {
+  @apply pb-[0.75rem] text-[0.8125rem] [color:var(--muted)];
+}
+
+.cf3-date-range button {
+  @apply min-h-[2.625rem];
+}
+
+.cf3-date-error {
+  @apply m-0 w-full text-[0.8125rem] text-[#ffb4b4];
+}
+
+body.island-mode .cf3-navigation,
+body.island-expanded-mode .cf3-navigation,
+body.island-docked-mode .cf3-navigation {
+  @apply hidden;
+}
+
+.search-box {
+  @apply min-w-0 w-full;
+}
+
+.search-mode {
+  @apply mr-[4px] max-w-[7rem] shrink-0 rounded-[0.5rem] border-0 bg-[#202331] px-[0.375rem] py-[0.5rem] text-[0.75rem] [color:var(--text)] [color-scheme:dark] [app-region:no-drag] focus-visible:outline-2 focus-visible:outline-[#a99cff];
+}
+
+#globalSearch {
+  @apply min-w-0;
+}
+
+.rail-more-button[hidden] {
+  @apply hidden;
+}
+
+/* 手动凭据输入保持可见，默认掩码；与一键授权共用原保存流程。 */
+#settingsBtn {
+  @apply inline-flex w-auto shrink-0 items-center justify-center whitespace-nowrap px-[0.75rem];
+}
+
+.credential-entry {
+  @apply flex min-w-0 items-stretch gap-[0.5rem];
+}
+
+#apiCredentialInput {
+  @apply min-w-0 flex-1 font-mono text-[0.875rem];
+}
+
+.credential-visibility {
+  @apply shrink-0 rounded-[0.75rem] border border-[#ffffff24] bg-[#ffffff0a] px-[0.75rem] text-[0.8125rem] [color:var(--text)] hover:bg-[#ffffff14];
+}
+
+.credential-help {
+  @apply m-0 text-[0.8125rem] leading-[1.6] [color:var(--muted)];
+}
+
+@media (max-width: 760px) {
+  .titlebar {
+    @apply grid-cols-[minmax(0,1fr)_auto];
+  }
+
+  .brand {
+    @apply col-start-1 row-start-1 min-w-0;
+  }
+
+  .top-actions {
+    @apply col-start-2 row-start-1;
+  }
+
+  .search-box {
+    @apply col-span-2 col-start-1 row-start-2;
+  }
+
+  .cf3-navigation {
+    @apply row-start-3;
+  }
+}
