{
  "name": "dsh-studio-cineflow",
  "version": "0.2.0",
  "description": "CineFlow：电影节目发现、片源管理、播放续播与局域网投屏",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "static",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "UPSTREAM.json",
    "studio.json",
    "sources.json",
    "scripts",
    "app/dist",
    "app/electron",
    "app/LICENSE",
    "app/package.json",
    "app/studio-sources.json",
    "app/studio-source-catalog.json",
    "patches",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "experimental"
      }
    }
  },
  "peerDependencies": {
    "dsh-studio-projects": "^0.5.0",
    "dsh-worktable": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "dsh-studio-projects": {
      "optional": true
    },
    "dsh-worktable": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs cineflow"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1997liuyh-boop/dsh-studio-cineflow.git",
    "directory": "studios/cineflow"
  },
  "homepage": "https://github.com/1997liuyh-boop/dsh-studio-cineflow#readme",
  "bugs": {
    "url": "https://github.com/1997liuyh-boop/dsh-studio-cineflow/issues"
  }
}
